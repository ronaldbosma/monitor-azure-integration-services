<policies>
    <inbound>
        <base />

        <!-- Configure backend details -->
        <set-backend-service backend-id="table-storage" />
        <authentication-managed-identity resource="https://storage.azure.com" />

        <!-- Set the necessary Azure Storage API request headers -->
        <set-header name="x-ms-version" exists-action="override">
            <value>2026-10-06</value>
        </set-header>
        <set-header name="x-ms-date" exists-action="override">
            <value>@(DateTime.UtcNow.ToString("R"))</value>
        </set-header>
        <set-header name="Accept" exists-action="override">
            <value>application/json;odata=nometadata</value>
        </set-header>
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>
